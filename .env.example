# Copiar a .env para desarrollo local. Todas las variables llevan el prefijo XIA_.
XIA_DATABASE_URL=postgresql://xia:xia@127.0.0.1:5433/xia
XIA_OLLAMA_URL=http://127.0.0.1:11434
XIA_MODELO_GENERACION=qwen3:8b
XIA_MODELO_EMBEDDINGS=bge-m3
XIA_SOURCES_FILE=sources.yaml

# Calibrar con `python eval/run_eval.py` (ver README).
XIA_UMBRAL_RELEVANCIA=0.45
XIA_TOP_K=6
XIA_CUOTA_LIMITE=30
XIA_CUOTA_VENTANA_HORAS=3

# Identidad y permisos. Xia valida el JWT de SCNexus Core (HS256): mismos valores que Jwt:Key / Jwt:Issuer / Jwt:Audience
# del Core (y que JWT_SECRET / JWT_ISSUER / JWT_AUDIENCE de api-odc-mba3). NUNCA subir el valor real al repositorio.
XIA_AUTENTICACION=jwt          # "ninguna" = solo desarrollo local: confía en usuario_ad y concede todo
XIA_JWT_SECRET=
XIA_JWT_ISSUER=SCNexus.Core
XIA_JWT_AUDIENCE=SCNexus.Users
# XIA_ROLES_ADMIN=["Admin"]    # roles que ven todas las áreas

# ── Servidor (docker-compose.servidor.yml; ver docs/DESPLIEGUE_SERVIDOR.md) ──
# XIA_DB_PASSWORD=               # obligatoria; solo letras y números (openssl rand -hex 16)
# XIA_BIND_HOST=0.0.0.0          # interfaz donde escucha la API (el firewall limita quién entra)
# XIA_OLLAMA_KEEP_ALIVE=24h      # cuánto tiempo mantiene Ollama los modelos cargados
