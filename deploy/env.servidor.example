# Copiar a ~/.config/xia/servidor.env (lo hace deploy/instalar-usuario.sh). Todas las variables son opcionales.

# Docker Desktop = desktop-linux (desarrollo). Docker Engine nativo = default (servidor).
XIA_DOCKER_CONTEXT=default
# Archivo compose en uso: docker-compose.yml (Desktop) o docker-compose.servidor.yml (Engine).
XIA_COMPOSE=docker-compose.servidor.yml

# Respaldos
# XIA_RESPALDO_DIR=$HOME/respaldos/xia
# XIA_RESPALDO_DIAS=14

# Alertas: además del diario del sistema y la notificación de escritorio, un webhook (Slack/Teams) opcional.
# XIA_ALERTA_WEBHOOK=https://...
